exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
])

genrule(
    name = "prismo_version_env",
    srcs = ["MODULE.bazel"],
    outs = ["prismo_version.env"],
    cmd = """
version=$$(perl -ne 'if (/^\\s*version\\s*=\\s*"([^\"]+)"/) { print $$1; exit }' $(location MODULE.bazel))
test -n "$$version"
printf 'PRISMO_VERSION=%s\n' "$$version" > "$@"
""",
    visibility = ["//visibility:public"],
)

alias(
    name = "prismo",
    actual = "//app:example_prismo",
)

alias(
    name = "format",
    actual = "//tools/format:format-all",
)
