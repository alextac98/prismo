load("@aspect_rules_lint//format:defs.bzl", "format_multirun")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
])

genrule(
    name = "prismo_version_env",
    srcs = ["MODULE.bazel"],
    outs = ["prismo_version.env"],
    cmd = """
version=$$(perl -ne 'if (/^\\s*version\\s*=\\s*"([^\"]+)"/) { print $$1; exit }' $(location MODULE.bazel))
test -n "$$version"
printf 'PRISMO_VERSION=%s\n' "$$version" > "$@"
""",
    visibility = ["//visibility:public"],
)

format_multirun(
    name = "format",
    c = "//tools/format:clang_format",
    cc = "//tools/format:clang_format",
    css = "//tools/format:prettier",
    html = "//tools/format:prettier",
    javascript = "//tools/format:prettier",
    markdown = "//tools/format:prettier",
    rust = "//tools/format:rustfmt",
    shell = "@aspect_rules_lint//format:shfmt",
    starlark = "//tools/format:buildifier",
    yaml = "@aspect_rules_lint//format:yamlfmt",
    rust_check_args = [
        "--edition",
        "2024",
        "--check",
    ],
    rust_fix_args = [
        "--edition",
        "2024",
    ],
)

alias(
    name = "prismo",
    actual = "//app:example_prismo",
)
