load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "prismo",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/core:core",
        "//plugins/synthetic:synthetic",
        "//crates/tui:tui",
    ],
    visibility = ["//visibility:public"],
)
