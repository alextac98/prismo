load("@prismo_crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("//bazel:defs.bzl", "prismo_bundle")

rust_binary(
    name = "prismo",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//crates/core",
        "//crates/plugin-host:plugin_host",
        "//crates/tui",
    ],
)

prismo_bundle(
    name = "example_prismo",
    plugins = [
        "//plugins/example-cpp:example_cpp_plugin",
        "//plugins/example-rust:example_rust_plugin",
    ],
    prismo = ":prismo",
    visibility = ["//visibility:public"],
)

prismo_bundle(
    name = "rigol_prismo",
    plugins = [
        "//plugins/rigol-psu:rigol_psu_plugin",
    ],
    prismo = ":prismo",
    visibility = ["//visibility:public"],
)
