load("@prismo_crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "plugin_protocol",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_plugin_protocol",
    edition = "2024",
    deps = all_crate_deps(normal = True),
    visibility = ["//visibility:public"],
)

rust_test(
    name = "plugin_protocol_test",
    crate = ":plugin_protocol",
    edition = "2024",
)
