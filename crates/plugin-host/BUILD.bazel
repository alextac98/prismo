load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "plugin_host",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_plugin_host",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/core:core",
        "//crates/plugin-protocol:plugin_protocol",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "plugin_host_test",
    crate = ":plugin_host",
    edition = "2024",
)
