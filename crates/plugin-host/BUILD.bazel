load("@prismo_crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "plugin_host",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_plugin_host",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//crates/core",
        "//crates/plugin-protocol:plugin_protocol",
    ],
)

rust_test(
    name = "plugin_host_test",
    crate = ":plugin_host",
    edition = "2024",
)
