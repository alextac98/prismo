load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_static_library")

rust_static_library(
    name = "plugin_sdk_ffi_static",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_plugin_sdk_ffi",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/plugin-protocol:plugin_protocol",
        "//crates/plugin-sdk-rust:plugin_sdk_rust",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

genrule(
    name = "generated_bindings",
    srcs = glob(["src/**/*.rs"]),
    outs = [
        "PluginSession.d.h",
        "PluginSession.h",
        "PluginSession.d.hpp",
        "PluginSession.hpp",
        "diplomat_runtime.h",
        "diplomat_runtime.hpp",
    ],
    tools = ["//tools/ffi:diplomat_codegen_tool"],
    cmd = """
set -euo pipefail
tmp="$(@D)/diplomat_codegen_tmp"
rm -rf "$$tmp"
mkdir -p "$$tmp/c" "$$tmp/cpp"
"$(location //tools/ffi:diplomat_codegen_tool)" "$(location src/lib.rs)" "$$tmp/c" "$$tmp/cpp"
cp "$$tmp/c/PluginSession.d.h" "$(@D)/PluginSession.d.h"
cp "$$tmp/c/PluginSession.h" "$(@D)/PluginSession.h"
cp "$$tmp/c/diplomat_runtime.h" "$(@D)/diplomat_runtime.h"
cp "$$tmp/cpp/PluginSession.d.hpp" "$(@D)/PluginSession.d.hpp"
cp "$$tmp/cpp/PluginSession.hpp" "$(@D)/PluginSession.hpp"
cp "$$tmp/cpp/diplomat_runtime.hpp" "$(@D)/diplomat_runtime.hpp"
""",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cpp_sdk",
    hdrs = [":generated_bindings"],
    includes = ["."],
    deps = [":plugin_sdk_ffi_static"],
    visibility = ["//visibility:public"],
)
