load("@prismo_crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("//tools/ffi:defs.bzl", "prismo_diplomat_bindings")

rust_static_library(
    name = "plugin_sdk_cpp_static",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_plugin_sdk_cpp",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//crates/plugin-protocol:plugin_protocol",
        "//crates/plugin-sdk/rust:plugin_sdk_rust",
    ],
)

prismo_diplomat_bindings(
    name = "generated_bindings",
    entry = "src/lib.rs",
    stem = "PluginSession",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cpp_sdk",
    hdrs = [":generated_bindings"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [":plugin_sdk_cpp_static"],
)
