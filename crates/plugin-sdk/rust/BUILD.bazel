load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "plugin_sdk_rust",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_plugin_sdk_rust",
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/plugin-protocol:plugin_protocol",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "plugin_sdk_rust_test",
    crate = ":plugin_sdk_rust",
    edition = "2024",
)
