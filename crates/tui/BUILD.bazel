load("@prismo_crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "tui",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "prismo_tui",
    edition = "2024",
    rustc_env_files = ["//:prismo_version_env"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        "//crates/core",
    ],
)

rust_test(
    name = "tui_test",
    crate = ":tui",
    edition = "2024",
)
