load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "prismo",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//crates/telemetry-core:telemetry_core",
        "//crates/telemetry-runtime:telemetry_runtime",
        "//crates/telemetry-synthetic:telemetry_synthetic",
        "//crates/telemetry-tui:telemetry_tui",
    ],
    visibility = ["//visibility:public"],
)
